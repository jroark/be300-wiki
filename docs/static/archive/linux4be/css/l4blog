.bodytext { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; color: #000000}
.code { font-family: Courier; font-size: 10px; color: #333333}
.menu {  font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; color: #990000; width: 100%}
.title { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 15px; color: #990000; font-weight: bold}
.subtitle { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; color: #990000; font-weight: bold}
.titleright { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; color: #EEEEEE; font-weight: bold}
.date { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; color: #555555;  }
.footer { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 10px; color: #555555; width: 100% }
body table {
	font-family : Verdana, Arial, Helvetica, sans-serif;
	font-size : 11px;
	line-height:15px;
}

h1 {
	color : #FFFFFF;
	font-size : 18px;
	font-weight : bold;
}

h2 {
	color : #999999;
	font-size : 13px;
	font-style : italic;
	font-weight : bold;
}

h3 {
	color : #990000;
	font-size : 13px;
	font-weight : bold;
}

h6 {
	color : #666666;
	font-size : 10px;
	font-weight : normal;
}

#maintable {
	border : 0px solid #333366;
}

#rightcolumn {
	border-left : 0px solid #333366;
}

a {
	color : #996666;
	text-decoration: none;
}

a:hover {
	text-decoration: underline;	
}

.footnote {
	color: #800;
	font-weight:bold;
	cursor:help;
}
